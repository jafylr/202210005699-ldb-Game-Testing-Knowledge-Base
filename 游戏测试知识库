```python
# 知识库自动更新脚本
import requests
import json
from datetime import datetime
import hashlib

class KnowledgeBaseUpdater:
    def __init__(self, base_url, api_key):
        self.base_url = base_url
        self.api_key = api_key
        self.update_log = []
        
    def check_for_updates(self):
        """检查知识库更新"""
        try:
            # 获取知识库最新版本信息
            headers = {"Authorization": f"Bearer {self.api_key}"}
            response = requests.get(f"{self.base_url}/api/version", headers=headers)
            latest_version = response.json()
            
            # 读取本地版本信息
            try:
                with open('knowledge_version.json', 'r') as f:
                    local_version = json.load(f)
            except FileNotFoundError:
                local_version = {"version": "0.0.0"}
            
            # 比较版本
            if self.compare_versions(latest_version['version'], local_version['version']) > 0:
                print(f"发现新版本: {local_version['version']} -> {latest_version['version']}")
                return latest_version
            else:
                print("当前已是最新版本")
                return None
                
        except Exception as e:
            print(f"检查更新失败: {e}")
            return None
    
    def compare_versions(self, version1, version2):
        """比较版本号"""
        v1 = list(map(int, version1.split('.')))
        v2 = list(map(int, version2.split('.')))
        for i in range(max(len(v1), len(v2))):
            num1 = v1[i] if i < len(v1) else 0
            num2 = v2[i] if i < len(v2) else 0
            if num1 > num2:
                return 1
            elif num1 < num2:
                return -1
        return 0
    
    def download_updates(self, update_info):
        """下载更新内容"""
        print(f"开始下载更新: {update_info['title']}")
        
        for content in update_info['contents']:
            try:
                # 下载内容文件
                response = requests.get(content['download_url'])
                content_data = response.json()
                
                # 计算文件哈希值
                file_hash = hashlib.sha256(json.dumps(content_data).encode()).hexdigest()
                
                if file_hash == content['hash']:
                    # 保存更新内容
                    filename = f"updates/{content['category']}/{content['id']}.json"
                    os.makedirs(os.path.dirname(filename), exist_ok=True)
                    
                    with open(filename, 'w', encoding='utf-8') as f:
                        json.dump(content_data, f, ensure_ascii=False, indent=2)
                    
                    # 记录更新日志
                    self.update_log.append({
                        'timestamp': datetime.now().isoformat(),
                        'content_id': content['id'],
                        'category': content['category'],
                        'action': 'download',
                        'status': 'success'
                    })
                    
                    print(f"✓ 已下载: {content['title']}")
                else:
                    print(f"✗ 文件校验失败: {content['title']}")
                    
            except Exception as e:
                print(f"下载失败: {content['title']} - {e}")
    
    def apply_updates(self):
        """应用更新到本地知识库"""
        updates_dir = "updates"
        applied_count = 0
        
        for category in os.listdir(updates_dir):
            category_dir = os.path.join(updates_dir, category)
            if os.path.isdir(category_dir):
                for update_file in os.listdir(category_dir):
                    if update_file.endswith('.json'):
                        update_path = os.path.join(category_dir, update_file)
                        
                        try:
                            with open(update_path, 'r', encoding='utf-8') as f:
                                update_content = json.load(f)
                            
                            # 合并到本地知识库
                            self.merge_into_knowledge_base(category, update_content)
                            applied_count += 1
                            
                            # 记录应用日志
                            self.update_log.append({
                                'timestamp': datetime.now().isoformat(),
                                'content_id': update_content.get('id', ''),
                                'category': category,
                                'action': 'apply',
                                'status': 'success'
                            })
                            
                            # 删除已应用的更新文件
                            os.remove(update_path)
                            
                        except Exception as e:
                            print(f"应用更新失败: {update_file} - {e}")
        
        print(f"已应用 {applied_count} 个更新")
        return applied_count
    
    def merge_into_knowledge_base(self, category, content):
        """将更新内容合并到知识库"""
        # 根据类别合并到不同的知识库文件
        knowledge_files = {
            'python': 'knowledge/python_skills.json',
            'testing': 'knowledge/testing_methods.json',
            'tools': 'knowledge/tools_library.json',
            'cases': 'knowledge/case_studies.json'
        }
        
        if category in knowledge_files:
            file_path = knowledge_files[category]
            
            # 加载现有知识
            if os.path.exists(file_path):
                with open(file_path, 'r', encoding='utf-8') as f:
                    existing_data = json.load(f)
            else:
                existing_data = []
            
            # 合并数据（避免重复）
            existing_ids = {item.get('id') for item in existing_data}
            if content.get('id') not in existing_ids:
                existing_data.append(content)
                
                # 保存合并后的数据
                with open(file_path, 'w', encoding='utf-8') as f:
                    json.dump(existing_data, f, ensure_ascii=False, indent=2)
                
                print(f"✓ 已合并到: {file_path}")
    
    def run_update_process(self):
        """运行完整的更新流程"""
        print("=== 知识库更新流程开始 ===")
        
        # 1. 检查更新
        update_info = self.check_for_updates()
        if not update_info:
            print("无需更新")
            return
        
        # 2. 下载更新
        self.download_updates(update_info)
        
        # 3. 应用更新
        applied = self.apply_updates()
        
        # 4. 更新本地版本
        if applied > 0:
            with open('knowledge_version.json', 'w') as f:
                json.dump({
                    'version': update_info['version'],
                    'updated_at': datetime.now().isoformat(),
                    'updates_applied': applied
                }, f, indent=2)
        
        # 5. 保存更新日志
        self.save_update_log()
        
        print("=== 知识库更新流程完成 ===")
    
    def save_update_log(self):
        """保存更新日志"""
        log_file = 'logs/update_history.json'
        os.makedirs(os.path.dirname(log_file), exist_ok=True)
        
        # 加载历史日志
        if os.path.exists(log_file):
            with open(log_file, 'r', encoding='utf-8') as f:
                history = json.load(f)
        else:
            history = []
        
        # 添加新日志
        history.extend(self.update_log)
        
        # 保存
        with open(log_file, 'w', encoding='utf-8') as f:
            json.dump(history, f, ensure_ascii=False, indent=2)
