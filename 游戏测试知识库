  import psutil
  import time
  import csv
  from datetime import datetime
  
  class MemoryMonitor:
      def __init__(self, process_name, interval=1.0):
          self.process_name = process_name
          self.interval = interval
          self.results = []
      
      def find_process(self):
          """查找目标进程"""
          for proc in psutil.process_iter(['pid', 'name']):
              if proc.info['name'] == self.process_name:
                  return proc
          return None
      
      def monitor(self, duration=60):
          """监控内存使用情况"""
          proc = self.find_process()
          if not proc:
              print(f"未找到进程: {self.process_name}")
              return
          
          print(f"开始监控进程 {self.process_name} (PID: {proc.pid})")
          start_time = time.time()
          
          while time.time() - start_time < duration:
              try:
                  # 获取内存信息
                  memory_info = proc.memory_info()
                  cpu_percent = proc.cpu_percent()
                  
                  record = {
                      'timestamp': datetime.now().isoformat(),
                      'rss': memory_info.rss,  # 物理内存使用
                      'vms': memory_info.vms,  # 虚拟内存使用
                      'cpu': cpu_percent,
                      'threads': proc.num_threads()
                  }
                  
                  self.results.append(record)
                  print(f"RSS: {record['rss'] // 1024 // 1024}MB, CPU: {record['cpu']}%")
                  
              except (psutil.NoSuchProcess, psutil.AccessDenied):
                  print("进程已结束或无法访问")
                  break
              
              time.sleep(self.interval)
          
          # 保存结果
          self.save_results()
      
      def save_results(self):
          """保存监控结果到CSV"""
          filename = f"memory_monitor_{self.process_name}_{datetime.now():%Y%m%d_%H%M%S}.csv"
          with open(filename, 'w', newline='') as f:
              writer = csv.DictWriter(f, fieldnames=self.results[0].keys())
              writer.writeheader()
              writer.writerows(self.results)
          print(f"结果已保存到: {filename}")
      
      def analyze_leak(self):
          """分析内存泄漏趋势"""
          if len(self.results) < 10:
              return
          
          # 计算内存增长趋势
          start_rss = self.results[0]['rss']
          end_rss = self.results[-1]['rss']
          growth_mb = (end_rss - start_rss) / 1024 / 1024
          
          print(f"内存变化: {start_rss // 1024 // 1024}MB -> {end_rss // 1024 // 1024}MB")
          print(f"增长: {growth_mb:.1f}MB")
          
          if growth_mb > 50:  # 如果增长超过50MB，可能存在泄漏
              print("警告：检测到可能的内存泄漏")
              return True
          return False
  



