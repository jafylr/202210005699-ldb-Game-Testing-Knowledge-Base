            player_count=results.get('player_count', 100),
            total_requests=results.get('total_requests', 0),
            metrics_rows=metrics_rows,
            qps_chart=qps_chart,
            conclusion=conclusion,
            recommendations=recommendations
        )
        
        return html_content

