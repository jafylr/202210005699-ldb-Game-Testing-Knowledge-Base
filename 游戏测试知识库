```python
# 知识质量评估脚本
import json
from datetime import datetime

class KnowledgeQualityAssessor:
    def __init__(self):
        self.assessment_criteria = {
            'accuracy': {
                'weight': 0.3,
                'indicators': ['有权威来源', '经过验证', '无矛盾信息']
            },
            'completeness': {
                'weight': 0.25,
                'indicators': ['覆盖全面', '有示例', '有实践指导']
            },
            'currency': {
                'weight': 0.2,
                'indicators': ['更新及时', '技术前沿', '无过时内容']
            },
            'clarity': {
                'weight': 0.15,
                'indicators': ['结构清晰', '表述易懂', '图文并茂']
            },
            'usability': {
                'weight': 0.1,
                'indicators': ['可直接使用', '有代码示例', '有模板']
            }
        }
    
    def assess_knowledge_item(self, item, category):
        """评估单个知识条目"""
        scores = {}
        total_score = 0
        
        for criterion, info in self.assessment_criteria.items():
            criterion_score = 0
            max_possible = len(info['indicators'])
            
            # 根据具体内容评分（简化的评分逻辑）
            if criterion == 'accuracy':
                if item.get('references'):
                    criterion_score += 1
                if item.get('verified'):
                    criterion_score += 1
                if not item.get('contradictions'):
                    criterion_score += 1
            
            elif criterion == 'completeness':
                if item.get('content'):
                    criterion_score += 1
                if item.get('examples'):
                    criterion_score += 1
                if item.get('practical_guide'):
                    criterion_score += 1
            
            elif criterion == 'currency':
                updated_at = item.get('updated_at', '')
                if updated_at:
                    # 检查是否在一年内更新
                    try:
                        update_date = datetime.fromisoformat(updated_at.replace('Z', '+00:00'))
                        days_since_update = (datetime.now() - update_date).days
                        if days_since_update < 365:
                            criterion_score += 1
                    except:
                        pass
                
                if item.get('is_advanced'):
                    criterion_score += 1
                if not item.get('deprecated'):
                    criterion_score += 1
            
            elif criterion == 'clarity':
                if item.get('structure_rating', 0) >= 3:
                    criterion_score += 1
                if item.get('readability', 0) >= 3:
                    criterion_score += 1
                if item.get('has_visuals'):
                    criterion_score += 1
            
            elif criterion == 'usability':
                if item.get('code_examples'):
                    criterion_score += 1
                if item.get('templates'):
                    criterion_score += 1
                if item.get('ready_to_use'):
                    criterion_score += 1
            
            # 计算加权分数
            weighted_score = (criterion_score / max_possible) * info['weight'] * 100
            scores[criterion] = weighted_score
            total_score += weighted_score
        
        # 添加质量标签
        quality_level = self.get_quality_level(total_score)
        
        assessment = {
            'item_id': item.get('id'),
            'title': item.get('title'),
            'category': category,
            'total_score': round(total_score, 1),
            'quality_level': quality_level,
            'criterion_scores': scores,
            'assessed_at': datetime.now().isoformat(),
            'recommendations': self.generate_recommendations(scores)
        }
        
        return assessment
    
    def get_quality_level(self, score):
        """根据分数获取质量等级"""
        if score >= 90:
            return '优秀'
        elif score >= 80:
            return '良好'
        elif score >= 70:
            return '中等'
        elif score >= 60:
            return '合格'
        else:
            return '需要改进'
    
    def generate_recommendations(self, scores):
        """生成改进建议"""
        recommendations = []
        
        if scores.get('accuracy', 0) < 20:
            recommendations.append("增加权威来源引用")
            recommendations.append("进行实际验证")
        
        if scores.get('completeness', 0) < 15:
            recommendations.append("补充更多示例")
            recommendations.append("添加实践指导")
        
        if scores.get('currency', 0) < 12:
            recommendations.append("更新过时内容")
            recommendations.append("添加最新技术信息")
        
        if scores.get('clarity', 0) < 10:
            recommendations.append("优化内容结构")
            recommendations.append("添加图表说明")
        
        if scores.get('usability', 0) < 8:
            recommendations.append("提供可直接使用的代码")
            recommendations.append("添加模板文件")
        
        return recommendations
    
    def assess_knowledge_base(self, knowledge_dir="knowledge"):
        """评估整个知识库"""
        assessments = []
        total_items = 0
        
        for category_file in os.listdir(knowledge_dir):
            if category_file.endswith('.json'):
                file_path = os.path.join(knowledge_dir, category_file)
                category = category_file.replace('.json', '')
                
                try:
                    with open(file_path, 'r', encoding='utf-8') as f:
                        knowledge_items = json.load(f)
                    
                    for item in knowledge_items:
                        assessment = self.assess_knowledge_item(item, category)
                        assessments.append(assessment)
                        total_items += 1
                        
                except Exception as e:
                    print(f"评估文件失败: {file_path} - {e}")
        
        # 计算总体统计
        if assessments:
            total_score = sum(a['total_score'] for a in assessments)
            avg_score = total_score / len(assessments)
            
            # 各质量等级统计
            quality_counts = {}
            for a in assessments:
                level = a['quality_level']
                quality_counts[level] = quality_counts.get(level, 0) + 1
            
            # 生成评估报告
            report = {
                'total_items_assessed': total_items,
                'average_score': round(avg_score, 1),
                'quality_distribution': quality_counts,
                'assessments': assessments,
                'generated_at': datetime.now().isoformat()
            }
            
            # 保存评估结果
            output_file = f"assessments/knowledge_quality_{datetime.now():%Y%m%d}.json"
            os.makedirs(os.path.dirname(output_file), exist_ok=True)
            
            with open(output_file, 'w', encoding='utf-8') as f:
                json.dump(report, f, ensure_ascii=False, indent=2)
            
            print(f"知识库评估完成！平均分: {avg_score:.1f}")
            print(f"质量分布: {quality_counts}")
            
            return report
        else:
            print("没有可评估的知识条目")
            return None
    
    def generate_quality_report_html(self, assessment_data):
        """生成HTML格式的质量报告"""
        html_template = """
        <!DOCTYPE html>
