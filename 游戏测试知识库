# 游戏测试数据生成脚本
import json
import random
from faker import Faker

class TestDataGenerator:
    def __init__(self):
        self.fake = Faker('zh_CN')
        
    def generate_player_data(self, count=100):
        """生成玩家测试数据"""
        players = []
        
        for i in range(count):
            player = {
                "player_id": f"player_{i+1:04d}",
                "username": self.fake.user_name(),
                "level": random.randint(1, 100),
                "gold": random.randint(0, 1000000),
                "vip_level": random.randint(0, 10),
                "create_time": self.fake.date_time_this_year().isoformat(),
                "last_login": self.fake.date_time_this_month().isoformat(),
                "equipment": self.generate_equipment(),
                "skills": self.generate_skills()
            }
            players.append(player)
        
        # 保存到JSON文件
        with open('test_players.json', 'w', encoding='utf-8') as f:
            json.dump(players, f, ensure_ascii=False, indent=2)
        
        print(f"已生成 {count} 条玩家测试数据")
        return players
    
    def generate_equipment(self):
        """生成装备数据"""
        equipment_types = ['weapon', 'armor', 'helmet', 'gloves', 'boots']
        equipment = {}
        
        for eq_type in equipment_types:
            if random.random() > 0.3:  # 70%概率有该装备
                equipment[eq_type] = {
                    "name": random.choice(['青铜剑', '铁甲', '皮帽', '布手套', '草鞋']),
                    "level": random.randint(1, 50),
                    "quality": random.choice(['普通', '精良', '稀有', '史诗', '传说']),
                    "durability": random.randint(1, 100)
                }
        
        return equipment
    
    def generate_skills(self):
        """生成技能数据"""
        skill_list = ['火球术', '冰箭术', '治疗术', '冲锋', '格挡', '连击']
        selected_skills = random.sample(skill_list, random.randint(3, 6))
        
        skills = {}
        for skill_name in selected_skills:
            skills[skill_name] = {
                "level": random.randint(1, 10),
                "experience": random.randint(0, 1000),
                "last_used": self.fake.date_time_this_month().isoformat()
            }
        
        return skills

