                time.sleep(random.uniform(0.1, 0.5))
                
            except Exception as e:
                self.results.put(("ERROR", f"玩家{player_id}交易失败: {str(e)}"))
    
    def stress_test_economy(self, player_count=50, duration=60):
        """压力测试经济系统"""
