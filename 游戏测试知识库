    def init_database(self):
        """初始化数据库"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # 创建学习主题表
        cursor.execute('''
        CREATE TABLE IF NOT EXISTS learning_topics (
            id INTEGER PRIMARY KEY,
            topic_name TEXT NOT NULL,
            category TEXT,
            priority INTEGER DEFAULT 3,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        ''')
        
        # 创建学习记录表
        cursor.execute('''
        CREATE TABLE IF NOT EXISTS learning_records (
            id INTEGER PRIMARY KEY,
            topic_id INTEGER,
            study_date DATE NOT NULL,
            duration_minutes INTEGER,
            content_covered TEXT,
            notes TEXT,
            confidence_level INTEGER, -- 1-5分
            FOREIGN KEY (topic_id) REFERENCES learning_topics (id)
        )
        ''')
        
        # 创建学习目标表
        cursor.execute('''
        CREATE TABLE IF NOT EXISTS learning_goals (
            id INTEGER PRIMARY KEY,
            goal_name TEXT NOT NULL,
            target_date DATE,
            status TEXT DEFAULT 'active',
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        ''')
        
        # 创建目标与主题关联表
        cursor.execute('''
        CREATE TABLE IF NOT EXISTS goal_topics (
            goal_id INTEGER,
            topic_id INTEGER,
            PRIMARY KEY (goal_id, topic_id),
            FOREIGN KEY (goal_id) REFERENCES learning_goals (id),
            FOREIGN KEY (topic_id) REFERENCES learning_topics (id)
        )
        ''')
        
        conn.commit()
        conn.close()
    
    def add_learning_topic(self, topic_name, category, priority=3):
        """添加学习主题"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
        INSERT INTO learning_topics (topic_name, category, priority)
        VALUES (?, ?, ?)
        ''', (topic_name, category, priority))
        
        topic_id = cursor.lastrowid
        conn.commit()
        conn.close()
        
        print(f"添加学习主题: {topic_name} (ID: {topic_id})")
        return topic_id
    
    def record_study_session(self, topic_id, duration_minutes, content_covered, notes="", confidence_level=3):
        """记录学习记录"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        today = datetime.now().date().isoformat()
        
        cursor.execute('''
        INSERT INTO learning_records (topic_id, study_date, duration_minutes, content_covered, notes, confidence_level)
        VALUES (?, ?, ?, ?, ?, ?)
        ''', (topic_id, today, duration_minutes, content_covered, notes, confidence_level))
        
        # 更新主题的更新时间
        cursor.execute('''
        UPDATE learning_topics 
        SET updated_at = CURRENT_TIMESTAMP
        WHERE id = ?
        ''', (topic_id,))
        
        conn.commit()
        conn.close()
        
        print(f"记录学习: {duration_minutes}分钟，主题ID: {topic_id}")
    
    def set_learning_goal(self, goal_name, target_date, topic_ids=None):
        """设置学习目标"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # 添加目标
        cursor.execute('''
        INSERT INTO learning_goals (goal_name, target_date)
        VALUES (?, ?)
        ''', (goal_name, target_date))
        
        goal_id = cursor.lastrowid
        
        # 关联主题
        if topic_ids:
            for topic_id in topic_ids:
                cursor.execute('''
                INSERT INTO goal_topics (goal_id, topic_id)
                VALUES (?, ?)
                ''', (goal_id, topic_id))
        
        conn.commit()
        conn.close()
        
        print(f"设置学习目标: {goal_name} (ID: {goal_id})")
        return goal_id
    
    def get_study_statistics(self, days=30):
        """获取学习统计"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # 计算起始日期
        start_date = (datetime.now() - timedelta(days=days)).date().isoformat()
        
        # 总学习时间
        cursor.execute('''
        SELECT SUM(duration_minutes) FROM learning_records
        WHERE study_date >= ?
        ''', (start_date,))
        
        total_minutes = cursor.fetchone()[0] or 0
        
        # 学习天数
        cursor.execute('''
        SELECT COUNT(DISTINCT study_date) FROM learning_records
        WHERE study_date >= ?
        ''', (start_date,))
        
        study_days = cursor.fetchone()[0]
        
        # 各主题学习时间
        cursor.execute('''
        SELECT t.topic_name, SUM(r.duration_minutes)
        FROM learning_records r
        JOIN learning_topics t ON r.topic_id = t.id
        WHERE r.study_date >= ?
        GROUP BY t.topic_name
        ORDER BY SUM(r.duration_minutes) DESC
        ''', (start_date,))
        
        topic_stats = cursor.fetchall()
        
        conn.close()
        
        stats = {
            'period_days': days,
            'total_study_minutes': total_minutes,
            'total_study_hours': total_minutes / 60,
            'study_days': study_days,
            'average_daily_minutes': total_minutes / days if days > 0 else 0,
            'topic_breakdown': [
                {'topic': topic, 'minutes': minutes} 
                for topic, minutes in topic_stats
            ]
        }
        
        return stats
    
    def generate_learning_report(self):
        """生成学习报告"""
        stats_30 = self.get_study_statistics(30)
        stats_7 = self.get_study_statistics(7)
        
        report = f"""
        === 个人学习进度报告 ===
        生成时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
        
        一、总体统计
        最近30天学习时间: {stats_30['total_study_hours']:.1f} 小时
        最近7天学习时间: {stats_7['total_study_hours']:.1f} 小时
        学习天数: {stats_30['study_days']} 天
        日均学习: {stats_30['average_daily_minutes']:.1f} 分钟
        
        二、主题分布（最近30天）
        """
        
        for item in stats_30['topic_breakdown'][:5]:  # 前5个主题
            percentage = (item['minutes'] / stats_30['total_study_minutes'] * 100) if stats_30['total_study_minutes'] > 0 else 0
            report += f"  {item['topic']}: {item['minutes']}分钟 ({percentage:.1f}%)\n"
        
        # 获取未学习主题
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
        SELECT topic_name FROM learning_topics t
        WHERE NOT EXISTS (
            SELECT 1 FROM learning_records r 
            WHERE r.topic_id = t.id 
            AND r.study_date >= date('now', '-30 days')
        )
        ''')
        
        inactive_topics = cursor.fetchall()
        conn.close()
        
        if inactive_topics:
            report += "\n三、需要关注的主题（30天内未学习）\n"
            for topic in inactive_topics[:5]:
                report += f"  {topic[0]}\n"
        
        return report
    
    def suggest_next_topic(self):
        """推荐下一个学习主题"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # 查找优先级高但学习时间少的主题
        cursor.execute('''
        SELECT t.id, t.topic_name, t.priority, 
               COALESCE(SUM(r.duration_minutes), 0) as total_minutes
        FROM learning_topics t
        LEFT JOIN learning_records r ON t.id = r.topic_id
        GROUP BY t.id, t.topic_name, t.priority
        ORDER BY t.priority DESC, total_minutes ASC
        LIMIT 3
        ''')
        
        suggestions = cursor.fetchall()
        conn.close()
        
        if suggestions:
            print("推荐学习主题：")
            for topic_id, topic_name, priority, minutes in suggestions:
                print(f"  {topic_name} (优先级: {priority}, 已学: {minutes}分钟)")
            
            return suggestions[0][0]  # 返回第一个推荐的topic_id
        else:
            print("暂无推荐主题")
            return None

# 使用示例
