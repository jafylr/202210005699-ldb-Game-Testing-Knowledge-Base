        start_time = time.time()
        while time.time() - start_time < duration:
            # 获取性能数据
            perf_data = self.client.get_performance_metrics()
            
            results['fps_samples'].append(perf_data['fps'])
            results['frame_times'].append(perf_data['frame_time'])
            results['memory_samples'].append(perf_data['memory_mb'])
            results['cpu_samples'].append(perf_data['cpu_percent'])
            
            time.sleep(0.1)  # 100ms采样一次
        
        # 计算统计指标
        results['avg_fps'] = sum(results['fps_samples']) / len(results['fps_samples'])
        results['min_fps'] = min(results['fps_samples'])
        results['max_fps'] = max(results['fps_samples'])
        
        results['avg_memory'] = sum(results['memory_samples']) / len(results['memory_samples'])
        results['max_memory'] = max(results['memory_samples'])
        
        # 计算帧时间稳定性
        import numpy as np
        frame_times_np = np.array(results['frame_times'])
        results['frame_time_std'] = np.std(frame_times_np)
        
        # 保存结果
        filename = os.path.join(self.output_dir, 
                               f"baseline_{scene_name}_{int(time.time())}.json")
        with open(filename, 'w') as f:
            json.dump(results, f, indent=2)
        
        print(f"基准测试完成：平均FPS={results['avg_fps']:.1f}, "
              f"内存={results['avg_memory']:.1f}MB")
        
        return results
    
    def run_stress_test(self, player_count=100, duration=300):
        """压力测试：模拟多玩家同屏"""
        print(f"开始压力测试：模拟{player_count}名玩家")
        
        # 生成测试脚本
        test_script = self._generate_stress_script(player_count)
        
        # 启动压力测试
        stress_client = StressTestClient()
        stress_client.load_script(test_script)
        
        results = stress_client.run_test(duration)
        
        # 分析服务器性能
        server_metrics = self._analyze_server_performance(results)
        
        # 生成报告
        report = self._generate_stress_test_report(results, server_metrics)
        
        # 保存报告
        filename = os.path.join(self.output_dir, 
                               f"stress_test_{player_count}players_{int(time.time())}.html")
        with open(filename, 'w') as f:
            f.write(report)
        
        print(f"压力测试完成，报告已保存到：{filename}")
        
        return results
    
    def _generate_stress_script(self, player_count):
        """生成压力测试脚本"""
        script = {
            'test_name': f'stress_test_{player_count}players',
            'players': [],
            'actions': []
        }
        
        # 创建玩家配置
        for i in range(player_count):
            player = {
                'id': f'stress_player_{i:03d}',
                'position': {
                    'x': random.uniform(-100, 100),
                    'y': 0,
                    'z': random.uniform(-100, 100)
                },
                'behavior': random.choice(['idle', 'walking', 'fighting', 'casting'])
            }
            script['players'].append(player)
        
        # 创建动作序列
        for second in range(0, 300, 5):  # 每5秒一个动作
            action = {
                'time': second,
                'type': 'mass_action',
                'action': random.choice([
                    'all_jump',
                    'all_cast_skill',
                    'all_move_random',
                    'all_attack_nearest'
                ])
            }
            script['actions'].append(action)
        
        return script
    
    def _analyze_server_performance(self, results):
        """分析服务器性能数据"""
        metrics = {
            'qps': [],  # 每秒查询数
            'response_times': [],
            'error_rates': []
        }
        
        for second_data in results.get('second_by_second', []):
            metrics['qps'].append(second_data['requests_per_second'])
            metrics['response_times'].extend(second_data['response_times'])
            metrics['error_rates'].append(second_data['error_rate'])
        
        # 计算统计指标
        import numpy as np
        
        analysis = {
            'avg_qps': np.mean(metrics['qps']) if metrics['qps'] else 0,
            'peak_qps': max(metrics['qps']) if metrics['qps'] else 0,
            'avg_response_time': np.mean(metrics['response_times']) if metrics['response_times'] else 0,
            'p95_response_time': np.percentile(metrics['response_times'], 95) if metrics['response_times'] else 0,
            'p99_response_time': np.percentile(metrics['response_times'], 99) if metrics['response_times'] else 0,
            'avg_error_rate': np.mean(metrics['error_rates']) if metrics['error_rates'] else 0,
            'max_error_rate': max(metrics['error_rates']) if metrics['error_rates'] else 0
        }
        
        return analysis
    
