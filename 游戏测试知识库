### 4.2 测试报告自动生成器
```python
# 自动化测试报告生成脚本
from datetime import datetime
import pandas as pd

class TestReportGenerator:
    def __init__(self, project_name="游戏测试项目"):
        self.project_name = project_name
        self.test_results = []
        
    def add_test_result(self, test_name, status, details, duration=None):
        """添加测试结果"""
        result = {
            "test_name": test_name,
            "status": status,  # PASS, FAIL, ERROR
            "details": details,
            "timestamp": datetime.now().isoformat(),
            "duration": duration
        }
        self.test_results.append(result)
        print(f"添加测试结果: {test_name} - {status}")
    
    def generate_summary(self):
        """生成测试摘要"""
        total_tests = len(self.test_results)
        passed_tests = sum(1 for r in self.test_results if r["status"] == "PASS")
        failed_tests = sum(1 for r in self.test_results if r["status"] == "FAIL")
        error_tests = sum(1 for r in self.test_results if r["status"] == "ERROR")
        
        pass_rate = (passed_tests / total_tests * 100) if total_tests > 0 else 0
        
        summary = {
            "total_tests": total_tests,
            "passed_tests": passed_tests,
            "failed_tests": failed_tests,
            "error_tests": error_tests,
            "pass_rate": pass_rate,
            "start_time": min([r["timestamp"] for r in self.test_results]) if self.test_results else None,
            "end_time": max([r["timestamp"] for r in self.test_results]) if self.test_results else None
        }
        
        return summary
    
    def export_to_excel(self, filename="test_report.xlsx"):
        """导出到Excel"""
        if not self.test_results:
            print("没有测试结果可导出")
            return
        
        # 转换为DataFrame
        df = pd.DataFrame(self.test_results)
        
        # 保存到Excel
        with pd.ExcelWriter(filename, engine='openpyxl') as writer:
            # 测试详情表
            df.to_excel(writer, sheet_name='测试详情', index=False)
            
            # 测试摘要表
            summary = self.generate_summary()
            summary_df = pd.DataFrame([summary])
            summary_df.to_excel(writer, sheet_name='测试摘要', index=False)
            
            # 统计图表
            status_counts = df['status'].value_counts()
            status_df = pd.DataFrame({
                '状态': status_counts.index,
                '数量': status_counts.values
            })
            status_df.to_excel(writer, sheet_name='状态统计', index=False)
        
        print(f"测试报告已导出到: {filename}")
        return filename
    
    def generate_html_report(self, filename="test_report.html"):
        """生成HTML格式的测试报告"""
        summary = self.generate_summary()
        
        html_content = f"""
        <!DOCTYPE html>
        <html>
        <head>
            <title>{self.project_name} 测试报告</title>
            <style>
                body {{ font-family: Arial, sans-serif; margin: 40px; }}
                .header {{ background: #2c3e50; color: white; padding: 20px; border-radius: 5px; }}
                .summary {{ background: #ecf0f1; padding: 20px; margin: 20px 0; border-radius: 5px; }}
                .metric {{ display: inline-block; margin: 10px 20px; }}
                .metric-value {{ font-size: 24px; font-weight: bold; }}
                .pass {{ color: #27ae60; }}
                .fail {{ color: #e74c3c; }}
                .error {{ color: #f39c12; }}
                table {{ width: 100%; border-collapse: collapse; margin: 20px 0; }}
                th {{ background: #3498db; color: white; padding: 10px; text-align: left; }}
                td {{ padding: 10px; border-bottom: 1px solid #ddd; }}
                .status-pass {{ background: #d5f4e6; }}
                .status-fail {{ background: #fadbd8; }}
                .status-error {{ background: #fef9e7; }}
            </style>
        </head>
        <body>
            <div class="header">
                <h1>{self.project_name}</h1>
                <h2>测试报告</h2>
                <p>生成时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}</p>
            </div>
            
            <div class="summary">
                <h2>测试摘要</h2>
                <div class="metric">
                    <div>总测试数</div>
                    <div class="metric-value">{summary['total_tests']}</div>
                </div>
                <div class="metric">
                    <div>通过</div>
                    <div class="metric-value pass">{summary['passed_tests']}</div>
                </div>
                <div class="metric">
                    <div>失败</div>
                    <div class="metric-value fail">{summary['failed_tests']}</div>
                </div>
                <div class="metric">
                    <div>错误</div>
                    <div class="metric-value error">{summary['error_tests']}</div>
                </div>
                <div class="metric">
                    <div>通过率</div>
                    <div class="metric-value pass">{summary['pass_rate']:.1f}%</div>
                </div>
            </div>
            
            <h2>详细测试结果</h2>
            <table>
                <tr>
                    <th>测试名称</th>
                    <th>状态</th>
                    <th>详情</th>
                    <th>执行时间</th>
                    <th>耗时</th>
                </tr>
                {"".join([self._generate_test_row(r) for r in self.test_results])}
            </table>
        </body>
        </html>
        """
        
        with open(filename, 'w', encoding='utf-8') as f:
            f.write(html_content)
        
        print(f"HTML测试报告已生成: {filename}")
        return filename
    
    def _generate_test_row(self, result):
        """生成测试结果行"""
        status_class = f"status-{result['status'].lower()}"
        
        return f"""
        <tr class="{status_class}">
            <td>{result['test_name']}</td>
            <td><strong>{result['status']}</strong></td>
            <td>{result['details']}</td>
            <td>{result['timestamp'][:19]}</td>
            <td>{result['duration'] if result['duration'] else '-'}秒</td>
        </tr>
        """

# 使用示例
report = TestReportGenerator("《剑与魔法》V2.0测试")

# 添加测试结果
