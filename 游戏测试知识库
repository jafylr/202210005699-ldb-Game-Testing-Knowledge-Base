      def test_loot_drop_rate(self, mob_id, item_id, expected_rate=0.01, 
                             sample_size=10000):
          """测试怪物掉落率"""
          print(f"测试怪物{mob_id}的物品{item_id}掉落率，期望：{expected_rate*100}%")
          
          # 模拟击杀
          drop_count = 0
          for i in range(sample_size):
              loot = LootSystem.generate_loot(mob_id)
              if item_id in loot:
                  drop_count += 1
              
              if i % 1000 == 0 and i > 0:
                  current_rate = drop_count / i
                  print(f"  已测试{i}次，当前掉落率：{current_rate*100:.2f}%")
          
          # 计算实际掉落率
          actual_rate = drop_count / sample_size
          print(f"最终结果：{drop_count}/{sample_size} = {actual_rate*100:.3f}%")
          
          # 统计检验（二项分布检验）
          import math
          # 计算置信区间
          z = 1.96  # 95%置信度
          margin = z * math.sqrt(actual_rate * (1-actual_rate) / sample_size)
          ci_lower = actual_rate - margin
          ci_upper = actual_rate + margin
          
          print(f"95%置信区间：[{ci_lower*100:.3f}%, {ci_upper*100:.3f}%]")
          
          # 判断是否符合期望
          if ci_lower <= expected_rate <= ci_upper:
              print("✓ 掉落率在期望范围内")
              return True
          else:
              print(f"✗ 掉落率异常！期望{expected_rate*100}%不在置信区间内")
              return False
      
