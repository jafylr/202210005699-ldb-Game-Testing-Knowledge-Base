# 实时性能监控脚本
import psutil
import time
import csv
from datetime import datetime

class GamePerformanceMonitor:
    def __init__(self, process_name="GameClient.exe", interval=1.0):
        self.process_name = process_name
        self.interval = interval
        self.metrics = []
        
    def find_game_process(self):
        """查找游戏进程"""
        for proc in psutil.process_iter(['pid', 'name', 'cmdline']):
            if self.process_name in proc.info['name']:
                return proc
        return None
    
    def collect_metrics(self, duration=60):
        """收集性能指标"""
        game_proc = self.find_game_process()
        if not game_proc:
            print("未找到游戏进程!")
            return
        
        print(f"开始监控进程: {game_proc.info['name']} (PID: {game_proc.pid})")
        
        start_time = time.time()
        while time.time() - start_time < duration:
            try:
                # 获取CPU使用率
                cpu_percent = game_proc.cpu_percent()
                
                # 获取内存使用
                memory_info = game_proc.memory_info()
                memory_mb = memory_info.rss / 1024 / 1024
                
                # 获取IO信息
                io_counters = game_proc.io_counters()
                
                # 记录指标
                metric = {
                    'timestamp': datetime.now().isoformat(),
                    'cpu_percent': cpu_percent,
                    'memory_mb': memory_mb,
                    'read_bytes': io_counters.read_bytes,
                    'write_bytes': io_counters.write_bytes,
                    'threads': game_proc.num_threads()
                }
                
                self.metrics.append(metric)
                print(f"CPU: {cpu_percent}% | 内存: {memory_mb:.1f}MB | 线程: {game_proc.num_threads()}")
                
                time.sleep(self.interval)
                
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                print("进程已结束或无访问权限")
                break
        
        self.save_metrics()
    
    def save_metrics(self):
        """保存性能数据到CSV"""
        if not self.metrics:
            return
            
        filename = f"performance_{self.process_name}_{datetime.now():%Y%m%d_%H%M%S}.csv"
        with open(filename, 'w', newline='') as f:
            writer = csv.DictWriter(f, fieldnames=self.metrics[0].keys())
            writer.writeheader()
            writer.writerows(self.metrics)
        
        print(f"性能数据已保存到: {filename}")
        
        # 简单分析
        cpu_values = [m['cpu_percent'] for m in self.metrics]
        memory_values = [m['memory_mb'] for m in self.metrics]
        
        print(f"CPU平均使用率: {sum(cpu_values)/len(cpu_values):.1f}%")
        print(f"内存平均使用: {sum(memory_values)/len(memory_values):.1f}MB")

