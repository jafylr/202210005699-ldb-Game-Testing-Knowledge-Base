        for skill_id in skill_sequence:
            if not self.game_client.is_skill_ready(skill_id):
                print(f"错误: 技能 {skill_id} 未就绪，连招中断")
                return False
            
            # 使用技能
            self.game_client.use_skill(skill_id)
            time.sleep(0.1)  # 技能释放间隔
        
        print("✓ 技能连招测试通过")
        return True

