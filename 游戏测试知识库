    def test_skill_cooldown(self, skill_id, expected_cooldown, tolerance=0.5):
        """测试技能冷却时间准确性"""
        print(f"测试技能 {skill_id} 的冷却时间...")
        
        # 记录技能释放时间
        use_time = time.time()
        self.game_client.use_skill(skill_id)
        
        # 等待技能可用
        is_ready = False
        check_interval = 0.1  # 每100ms检查一次
        
        while not is_ready:
            time.sleep(check_interval)
            is_ready = self.game_client.is_skill_ready(skill_id)
            
            # 超时保护
            if time.time() - use_time > expected_cooldown * 2:
                print("错误: 技能冷却超时!")
                return False
        
        actual_cooldown = time.time() - use_time
        time_diff = abs(actual_cooldown - expected_cooldown)
        
        print(f"实际冷却时间: {actual_cooldown:.2f}秒")
        print(f"预期冷却时间: {expected_cooldown:.2f}秒")
        print(f"时间差: {time_diff:.2f}秒")
        
        if time_diff <= tolerance:
            print("✓ 冷却时间测试通过")
            return True
        else:
            print("✗ 冷却时间测试失败")
            return False
    
    def test_skill_chain(self, skill_sequence):
        """测试技能连招是否顺畅"""
