  import socket
  import struct
  
  class GameProtocolTester:
      def __init__(self, host='127.0.0.1', port=8888):
          self.host = host
          self.port = port
          
      def test_tcp_connection(self):
          """测试TCP连接和心跳包"""
          sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
          sock.settimeout(5.0)
          
          try:
              sock.connect((self.host, self.port))
              
              # 发送登录包
              login_packet = self._build_login_packet('test_user', 'password')
              sock.send(login_packet)
              
              # 接收响应
              response = sock.recv(1024)
              if self._parse_response(response) == 'LOGIN_SUCCESS':
                  print("TCP登录测试：通过")
                  
                  # 测试心跳包
                  for i in range(10):
                      heartbeat = self._build_heartbeat_packet()
                      sock.send(heartbeat)
                      response = sock.recv(1024)
                      if self._parse_response(response) != 'HEARTBEAT_ACK':
                          print(f"第{i+1}次心跳失败")
                          return False
                  
                  print("心跳包测试：通过")
                  return True
          except socket.timeout:
              print("连接超时")
          finally:
              sock.close()
          return False
      
      def _build_login_packet(self, username, password):
          """构建登录数据包"""
          # 协议格式：协议头(4字节) + 用户名长度(1字节) + 用户名 + 密码长度(1字节) + 密码
          username_bytes = username.encode('utf-8')
          password_bytes = password.encode('utf-8')
          
          packet = b'LOGN'  # 协议头
          packet += struct.pack('B', len(username_bytes))
          packet += username_bytes
          packet += struct.pack('B', len(password_bytes))
          packet += password_bytes
          
          return packet
  

