      def _check_damage_distribution(self, damages):
          """检查伤害分布是否符合预期"""
          from collections import Counter
          
          # 将伤害分组
          bins = [0, 100, 200, 300, 400, 500, 600, 700, 800, 900, 1000]
          hist = Counter()
          
          for damage in damages:
              for i in range(len(bins)-1):
                  if bins[i] <= damage < bins[i+1]:
                      hist[f"{bins[i]}-{bins[i+1]}"] += 1
                      break
          
          print("伤害分布：")
          for range_str, count in sorted(hist.items()):
              percentage = count / len(damages) * 100
              print(f"  {range_str}: {count}次 ({percentage:.1f}%)")
          
          # 检查是否有异常聚集
          max_percent = max(percentage for _, percentage in 
                           [(k, v/len(damages)*100) for k, v in hist.items()])
          if max_percent > 70:  # 如果70%以上伤害集中在一个区间
              print("警告：伤害分布不均匀")
