            if value <= thresholds['good']:
                return '<span class="good">良好</span>'
            elif value <= thresholds['warning']:
                return '<span class="warning">警告</span>'
            else:
                return '<span class="critical">严重</span>'
        
        # 定义阈值
        thresholds = {
            'avg_response_time': {'good': 50, 'warning': 100},
            'p95_response_time': {'good': 100, 'warning': 200},
            'avg_error_rate': {'good': 0.01, 'warning': 0.05}
        }
        
        # 生成指标行
