# 基于图像识别的UI自动化测试框架
import cv2
import numpy as np
import pyautogui
import time

class GameUIAutomator:
    def __init__(self, confidence_threshold=0.8):
        self.confidence_threshold = confidence_threshold
        self.screenshot_dir = "screenshots"
        os.makedirs(self.screenshot_dir, exist_ok=True)
        
    def find_ui_element(self, template_path, region=None):
        """在屏幕上查找UI元素"""
        # 截取屏幕
        screenshot = pyautogui.screenshot(region=region)
        screenshot_np = np.array(screenshot)
        screenshot_gray = cv2.cvtColor(screenshot_np, cv2.COLOR_RGB2GRAY)
        
        # 加载模板图像
        template = cv2.imread(template_path, 0)
        if template is None:
            raise FileNotFoundError(f"找不到模板图像: {template_path}")
        
        # 模板匹配
        result = cv2.matchTemplate(screenshot_gray, template, cv2.TM_CCOEFF_NORMED)
        min_val, max_val, min_loc, max_loc = cv2.minMaxLoc(result)
        
        if max_val >= self.confidence_threshold:
            # 计算元素中心位置
            h, w = template.shape
            center_x = max_loc[0] + w // 2
            center_y = max_loc[1] + h // 2
            
            return (center_x, center_y, max_val)
        
        return None
    
    def click_ui_element(self, template_path, wait_time=1.0, max_attempts=3):
        """点击UI元素"""
        for attempt in range(max_attempts):
            print(f"尝试点击 {template_path} (第{attempt+1}次)...")
            
            element_pos = self.find_ui_element(template_path)
            if element_pos:
                x, y, confidence = element_pos
                print(f"找到元素，置信度: {confidence:.2f}, 坐标: ({x}, {y})")
                
                # 移动鼠标并点击
                pyautogui.moveTo(x, y, duration=0.2)
                pyautogui.click()
                
                # 保存截图用于调试
                timestamp = time.strftime("%Y%m%d_%H%M%S")
                screenshot_path = f"{self.screenshot_dir}/click_{os.path.basename(template_path)}_{timestamp}.png"
                pyautogui.screenshot(screenshot_path)
                
                print(f"✓ 点击成功，截图保存到: {screenshot_path}")
                return True
            
            # 等待后重试
            time.sleep(wait_time)
        
        print(f"✗ 找不到UI元素: {template_path}")
        return False
    
    def verify_ui_state(self, expected_elements, timeout=10):
        """验证UI状态"""
        start_time = time.time()
        found_elements = []
        
        while time.time() - start_time < timeout:
            current_found = []
            
            for element_name, template_path in expected_elements.items():
                if self.find_ui_element(template_path):
                    current_found.append(element_name)
            
            if set(current_found) == set(expected_elements.keys()):
                print(f"✓ 所有UI元素都正确显示: {current_found}")
                return True
            
            found_elements = current_found
            time.sleep(0.5)
        
        print(f"✗ UI验证失败，找到的元素: {found_elements}")
        print(f"  未找到的元素: {set(expected_elements.keys()) - set(found_elements)}")
        return False

