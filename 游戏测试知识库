import matplotlib.pyplot as plt

class GameFPSMonitor:
    def __init__(self, game_window_title="My Game"):
        self.game_window_title = game_window_title
        self.fps_samples = []
        self.frame_times = []
        self.cpu_usage = []
        self.memory_usage = []
        
    def capture_fps(self, duration=60, interval=0.1):
        """捕获游戏帧率数据"""
        print(f"开始监控游戏帧率，时长: {duration}秒")
        
        start_time = time.time()
        frame_count = 0
        last_time = start_time
        
        while time.time() - start_time < duration:
            current_time = time.time()
            
            # 模拟获取帧率数据（实际中需要游戏API或外部工具）
            # 这里使用简单的时间间隔计算
            if current_time - last_time >= interval:
                frame_time = current_time - last_time
                fps = 1.0 / frame_time if frame_time > 0 else 0
                
                self.frame_times.append(frame_time * 1000)  # 转换为毫秒
                self.fps_samples.append(fps)
                
                # 获取系统资源使用情况
                cpu_percent = psutil.cpu_percent(interval=None)
                self.cpu_usage.append(cpu_percent)
                
                # 找到游戏进程的内存使用
                for proc in psutil.process_iter(['name', 'memory_percent']):
                    if self.game_window_title in proc.info['name']:
                        self.memory_usage.append(proc.info['memory_percent'])
                        break
                
                frame_count += 1
                last_time = current_time
            
            time.sleep(0.001)  # 降低CPU使用
        
        print(f"监控完成，采集到 {frame_count} 个数据点")
        
