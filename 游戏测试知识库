            metrics_rows += f'''
            <tr>
                <td>{metric_name.replace('_', ' ').title()}</td>
                <td>{metric_value:.2f}</td>
                <td>{status}</td>
                <td>{thresholds.get(metric_name, {}).get('warning', '-')}</td>
            </tr>
            '''
        
        # 生成图表（简化版，实际需使用matplotlib生成）
        qps_chart = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8/5+hHgAHggJ/PchI7wAAAABJRU5ErkJggg=="  # 1x1像素占位符
        
        # 生成结论
        if analysis['avg_error_rate'] < 0.01 and analysis['p95_response_time'] < 100:
            conclusion = "系统表现良好，能够承受当前压力。"
        elif analysis['avg_error_rate'] < 0.05:
            conclusion = "系统表现一般，建议优化。"
        else:
            conclusion = "系统表现不佳，需要立即优化。"
        
        # 生成建议
        recommendations = ''
        if analysis['avg_response_time'] > 100:
            recommendations += '<li>优化数据库查询，减少响应时间</li>'
        if analysis['avg_error_rate'] > 0.01:
            recommendations += '<li>增加服务器资源，减少错误率</li>'
        if not recommendations:
            recommendations = '<li>当前配置满足需求，继续保持</li>'
        
        # 填充模板
        html_content = html_template.format(
            timestamp=time.strftime('%Y-%m-%d %H:%M:%S'),
            test_type='玩家同屏压力测试',
