  import json
  from datetime import datetime
  
  def analyze_crash_logs(log_dir, output_file):
      """分析崩溃日志，提取高频错误"""
      error_patterns = {}
      for filename in os.listdir(log_dir):
          if filename.endswith('.log'):
              with open(os.path.join(log_dir, filename), 'r') as f:
                  for line in f:
                      if 'ERROR' in line or 'CRASH' in line:
                          # 提取错误类型
                          error_type = line.split(':')[0] if ':' in line else line[:50]
                          error_patterns[error_type] = error_patterns.get(error_type, 0) + 1
      
      # 按频率排序并保存
      sorted_errors = sorted(error_patterns.items(), key=lambda x: x[1], reverse=True)
      with open(output_file, 'w') as f:
          json.dump({
              'analyzed_at': datetime.now().isoformat(),
              'total_logs': len(os.listdir(log_dir)),
              'error_summary': sorted_errors[:20]  # 只显示前20个高频错误
