# 游戏经济系统测试脚本
import random
import threading
from queue import Queue

class EconomySystemTester:
    def __init__(self, server_api):
        self.server_api = server_api
        self.results = Queue()
        
    def simulate_player_transaction(self, player_id, iterations=100):
        """模拟玩家交易行为"""
        for i in range(iterations):
            try:
                # 获取玩家当前金币
                gold_before = self.server_api.get_player_gold(player_id)
                
                # 随机生成交易金额(1-100金币)
                amount = random.randint(1, 100)
                
                # 50%概率购买，50%概率出售
                if random.random() > 0.5:
                    # 购买物品
                    success = self.server_api.buy_item(player_id, "potion", amount)
                    if success:
                        gold_after = self.server_api.get_player_gold(player_id)
                        expected_gold = gold_before - amount * 10  # 假设药水单价10金币
                        
                        if gold_after == expected_gold:
                            self.results.put(("PASS", f"玩家{player_id}购买成功"))
                        else:
                            self.results.put(("FAIL", f"玩家{player_id}金币计算错误"))
                else:
                    # 出售物品
                    success = self.server_api.sell_item(player_id, "potion", amount)
                    if success:
                        gold_after = self.server_api.get_player_gold(player_id)
                        expected_gold = gold_before + amount * 8  # 假设药水售价8金币
                        
                        if gold_after == expected_gold:
                            self.results.put(("PASS", f"玩家{player_id}出售成功"))
                        else:
                            self.results.put(("FAIL", f"玩家{player_id}金币计算错误"))
                            
                # 随机等待
                time.sleep(random.uniform(0.1, 0.5))
                
            except Exception as e:
                self.results.put(("ERROR", f"玩家{player_id}交易失败: {str(e)}"))
    
    def stress_test_economy(self, player_count=50, duration=60):
        """压力测试经济系统"""
        print(f"开始经济系统压力测试: {player_count}名玩家")
        
        threads = []
        start_time = time.time()
        
        # 创建玩家线程
        for i in range(player_count):
            player_id = f"test_player_{i:03d}"
            thread = threading.Thread(
                target=self.simulate_player_transaction,
                args=(player_id, 100)  # 每名玩家执行100次交易
            )
            threads.append(thread)
            thread.start()
        
        # 等待所有线程完成
        for thread in threads:
            thread.join()
        
        end_time = time.time()
        
        # 分析结果
        total_transactions = 0
        passed_transactions = 0
        failed_transactions = 0
        error_transactions = 0
        
        while not self.results.empty():
            result = self.results.get()
            total_transactions += 1
            
            if result[0] == "PASS":
                passed_transactions += 1
            elif result[0] == "FAIL":
                failed_transactions += 1
            else:
                error_transactions += 1
        
        # 输出报告
        print("\n=== 经济系统压力测试报告 ===")
        print(f"测试时长: {end_time - start_time:.2f}秒")
        print(f"总交易次数: {total_transactions}")
        print(f"成功交易: {passed_transactions}")
        print(f"失败交易: {failed_transactions}")
        print(f"错误交易: {error_transactions}")
        print(f"成功率: {passed_transactions/total_transactions*100:.1f}%")
        
        if failed_transactions == 0 and error_transactions == 0:
            print("✓ 经济系统压力测试通过")
            return True
        else:
            print("✗ 经济系统压力测试失败")
            return False

# 使用示例
