# 网络延迟模拟测试
```python
# 网络延迟模拟测试脚本
import socket
import time
import threading

class NetworkLatencyTester:
    def __init__(self, server_ip='127.0.0.1', server_port=8888):
        self.server_ip = server_ip
        self.server_port = server_port
        
    def test_ping_latency(self, test_count=100):
        """测试游戏服务器的Ping延迟"""
        latencies = []
        
        for i in range(test_count):
            start_time = time.time()
            
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(2.0)
                sock.connect((self.server_ip, self.server_port))
                
                # 发送心跳包
                sock.send(b'PING')
                response = sock.recv(1024)
                
                if response == b'PONG':
                    latency = (time.time() - start_time) * 1000  # 毫秒
                    latencies.append(latency)
                    
            except socket.timeout:
                print(f"第{i+1}次测试: 超时")
            finally:
                sock.close()
            
            time.sleep(0.1)  # 100ms间隔
        
        # 输出统计结果
        if latencies:
            avg_latency = sum(latencies) / len(latencies)
            max_latency = max(latencies)
            min_latency = min(latencies)
            
            print(f"延迟统计: 平均{avg_latency:.1f}ms, 最大{max_latency:.1f}ms, 最小{min_latency:.1f}ms")
            print(f"丢包率: {(test_count - len(latencies)) / test_count * 100:.1f}%")
        
        return latencies

# 使用示例
tester = NetworkLatencyTester('game-server.com', 30000)
latency_data = tester.test_ping_latency()
